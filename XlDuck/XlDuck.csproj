<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableComHosting>true</EnableComHosting>
    <ExcelDnaPackCompressResources>false</ExcelDnaPackCompressResources>
    <ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
    <ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
    <RunExcelDnaPack>false</RunExcelDnaPack>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
    <PackageReference Include="ExcelDna.Integration" Version="1.9.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="ExcelDna.Interop" Version="15.0.1" />
    <ProjectReference Include="../XlDuck.Client/XlDuck.Client.csproj" />
    <ProjectReference Include="../XlDuck.Host/XlDuck.Host.csproj" />
    <ProjectReference Include="../XlDuck.Worker/XlDuck.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../artifacts/reader-extensions/v1.5.6/windows_amd64/*.duckdb_extension" Link="readers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../artifacts/preview-assets/**/*" Link="preview/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Preview/preview.html;Preview/preview.js;Preview/preview.css" Link="preview/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyWorkbookWorker" AfterTargets="Build">
    <MSBuild Projects="../XlDuck.Worker/XlDuck.Worker.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="WorkerTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <WorkerDirectory>@(WorkerTargetPath->'%(RootDir)%(Directory)')</WorkerDirectory>
    </PropertyGroup>
    <Error Condition="'$(WorkerDirectory)' == '' Or !Exists('$(WorkerDirectory)XlDuck.Worker.dll')" Text="The workbook worker output could not be located." />
    <ItemGroup>
      <WorkerFiles Include="$(WorkerDirectory)/*" />
      <WorkerNative Include="$(WorkerDirectory)/runtimes/win-x64/native/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(TargetDir)worker" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WorkerNative)" DestinationFolder="$(TargetDir)worker/runtimes/win-x64/native" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon.xml" />
  </ItemGroup>

</Project>
