<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="XlDuckTab" label="XLDuck">
        <group id="PreviewGroup" label="Preview">
          <toggleButton id="PreviewPaneToggle"
                        label="Preview Pane"
                        size="large"
                        imageMso="FindDialog"
                        onAction="OnPreviewPaneToggle"
                        getPressed="GetPreviewPanePressed"
                        screentip="Toggle Preview Pane"
                        supertip="Show or hide the preview pane that displays handle contents." />
        </group>
        <group id="QueryGroup" label="Query">
          <toggleButton id="QueryPauseToggle"
                        label="Pause Queries"
                        size="large"
                        imageMso="MacroRecorderPause"
                        onAction="OnQueryPauseToggle"
                        getPressed="GetQueryPaused"
                        screentip="Pause/Resume Queries"
                        supertip="Pause new computations in this workbook. Resuming reuses completed results." />
          <button id="CancelQueryButton" label="Cancel Query"
                  imageMso="CancelRequest" size="large"
                  onAction="OnCancelQuery"
                  screentip="Cancel Running Query"
                  supertip="Cancel running and queued work in this workbook. Completed results are retained." />
          <button id="RetryButton" label="Retry failed results" onAction="OnRetry" imageMso="Refresh" />
        </group>
        <group id="ConfigGroup" label="Workbook">
          <button id="ConnectionsButton" label="Enable / Connections" onAction="OnConnections" imageMso="Connections" size="large"
                  supertip="Enable broad file and network reads for this workbook and configure S3 profiles." />
          <button id="RestartButton" label="Restart XlDuck"
                  imageMso="Refresh" size="large"
                  onAction="OnRestart"
                  screentip="Recompute this workbook"
                  supertip="Discard this workbook's results and fetch its sources again. Other workbooks are unaffected." />
          <button id="DisableButton" label="Disable workbook" onAction="OnDisable" />
        </group>
        <group id="InfoGroup" label="Info">
          <button id="VersionButton"
                  label="Version"
                  size="normal"
                  imageMso="Info"
                  onAction="OnVersionClick"
                  screentip="Show XLDuck Version"
                  supertip="Display the XLDuck add-in and DuckDB library versions." />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
